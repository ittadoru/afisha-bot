# Safe names and local-only examples. Never commit real values.
AFISHA_ENVIRONMENT=staging
AFISHA_DEBUG=false
AFISHA_LOG_LEVEL=INFO
AFISHA_DATABASE_URL=postgresql+asyncpg://afisha:change-me@postgres:5432/afisha
AFISHA_REDIS_URL=redis://redis:6379/0
AFISHA_MEDIA_ROOT=/var/lib/afisha/media
AFISHA_READINESS_TIMEOUT_SECONDS=2
AFISHA_NOMINATIM_URL=http://nominatim:8080
AFISHA_NOMINATIM_TIMEOUT_SECONDS=1.2
AFISHA_PUBLIC_BASE_URL=https://podvval.xyz
AFISHA_MINI_APP_URL=https://podvval.xyz/app
AFISHA_ADMIN_BASE_URL=https://admin.podvval.xyz

# Telegram bot. Real secrets are supplied only through the ignored .env file.
BOT_TOKEN=
AFISHA_AUTH_HMAC_SECRET=generate-a-random-secret-of-at-least-32-characters
# Optional. Leave empty for a direct Telegram connection.
TG_PROXY_URL=

POSTGRES_DB=afisha
POSTGRES_USER=afisha
POSTGRES_PASSWORD=change-me

# Stage A only documents the future one-time owner bootstrap. The password is
# intentionally added later, together with the admin implementation.
AFISHA_BOOTSTRAP_ADMIN_LOGIN=Atari

# Regional extract configuration is supplied only on the VPS.
NOMINATIM_PBF_URL=
NOMINATIM_PBF_SHA256=
NOMINATIM_PASSWORD=change-me

# Image references are replaced by digest-pinned values on the VPS.
AFISHA_APP_IMAGE=afishabot-g6:local
AFISHA_FRONTEND_IMAGE=afishabot-frontend:local
NODE_IMAGE=node:22.22.0-alpine
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
POSTGIS_IMAGE=postgis/postgis:18-3.6
REDIS_IMAGE=redis:8.2-alpine
NGINX_IMAGE=nginx:1.29-alpine
NOMINATIM_IMAGE=mediagis/nominatim:5.3
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
