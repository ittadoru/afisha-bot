# Safe names and local-only examples. Never commit real values.
AFISHA_ENVIRONMENT=staging
AFISHA_DEBUG=false
AFISHA_LOG_LEVEL=INFO
AFISHA_DATABASE_URL=postgresql+asyncpg://afisha:change-me@postgres:5432/afisha
AFISHA_REDIS_URL=redis://redis:6379/0
AFISHA_MEDIA_ROOT=/var/lib/afisha/media
AFISHA_READINESS_TIMEOUT_SECONDS=2

POSTGRES_DB=afisha
POSTGRES_USER=afisha
POSTGRES_PASSWORD=change-me

# Regional extract configuration is supplied only on the VPS.
NOMINATIM_PBF_URL=
NOMINATIM_PBF_SHA256=
NOMINATIM_PASSWORD=change-me

# Image references are replaced by digest-pinned values on the VPS.
AFISHA_APP_IMAGE=afishabot-g6:local
POSTGIS_IMAGE=postgis/postgis:18-3.6
REDIS_IMAGE=redis:8.2-alpine
NGINX_IMAGE=nginx:1.29-alpine
NOMINATIM_IMAGE=mediagis/nominatim:5.3
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
