{
  "openapi": "3.1.0",
  "info": { "title": "Afisha API", "version": "0.1.0" },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "tags": ["platform"],
        "responses": { "200": { "description": "Successful response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } } }
      }
    },
    "/geo/reverse": {
      "get": {
        "operationId": "reverse_geocode_geo_reverse_get",
        "tags": ["geo"],
        "parameters": [
          { "name": "lat", "in": "query", "required": true, "schema": { "type": "number", "minimum": -90, "maximum": 90 } },
          { "name": "lon", "in": "query", "required": true, "schema": { "type": "number", "minimum": -180, "maximum": 180 } }
        ],
        "responses": {
          "200": { "description": "Canonical address", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReverseGeocodingResponse" } } } },
          "503": { "description": "Provider unavailable" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok", "unavailable"] } }
      },
      "ReverseGeocodingResponse": {
        "type": "object",
        "required": ["display_name", "street", "city", "region", "provider_place_id", "locale", "precision"],
        "properties": {
          "display_name": { "type": "string" },
          "street": { "type": ["string", "null"] },
          "city": { "type": "string" },
          "region": { "type": "string" },
          "provider_place_id": { "type": "string" },
          "locale": { "type": "string" },
          "precision": { "type": "string" }
        }
      }
    }
  }
}
