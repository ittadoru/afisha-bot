flowchart TB
    verified["Verified Telegram auth context<br/>no raw token/initData/profile"]
    lookup["Normalize Telegram method<br/>derive versioned HMAC lookup key"]
    begin["BEGIN accounts owner transaction"]
    lock["Lookup Telegram key<br/>lock matching identity row"]
    classify{"Resolution result"}

    verified --> lookup --> begin --> lock --> classify

    classify -->|"key absent"| create["Create User + telegram_identity<br/>create random default Profile"]
    classify -->|"one matching User"| attach["Use existing User"]
    classify -->|"duplicate/race conflict<br/>or erased/restricted guard denies"| conflict["No identity/session mutation<br/>caller records protocol denial"]

    create --> current["Update first/last auth and method<br/>bot state only from allowed evidence"]
    attach --> current
    current --> session["Create Mini session row<br/>protected credential only"]
    session --> facts["Write identity/profile facts when new<br/>same transaction outbox"]
    facts --> commit{"COMMIT succeeds?"}
    commit -->|"yes"| cookie["Return internal user_id<br/>issue Mini session after commit"]
    commit -->|"no"| abort["No usable session<br/>safe new auth flow required"]

    lock -. "unique race" .-> retry["Rollback and bounded re-resolve<br/>never merge rows"]
    retry --> begin
