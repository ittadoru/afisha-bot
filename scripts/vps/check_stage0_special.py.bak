#!/usr/bin/env python3
"""Stage 0 deployment check: admin login flow + special event creation."""
import json
import os
import sys
import time

import requests

BASE = "https://admin.podvval.xyz/api/admin"
PUBLIC = "https://podvval.xyz/api"
ORIGIN = "https://admin.podvval.xyz"
HEADERS = {"Host": "admin.podvval.xyz", "Origin": ORIGIN}

session = requests.Session()
session.headers.update({"Accept": "application/json"})

bootstrap = session.post(
    f"{BASE}/auth/bootstrap", headers={**HEADERS, "Host": "admin.podvval.xyz"}
)
bootstrap.raise_for_status()
csrf = bootstrap.json()["csrf_token"]

login = session.post(
    f"{BASE}/auth/login",
    headers={**HEADERS, "X-Afisha-Admin-CSRF": csrf, "Content-Type": "application/json"},
    json={"login": os.environ["ADMIN_LOGIN"], "password": os.environ["ADMIN_PASSWORD"]},
)
print("login:", login.status_code, login.json())
login.raise_for_status()
session_csrf = login.json()["csrf_token"]

cities = requests.get(f"{PUBLIC}/geo/catalog").json()["cities"]
print("cities:", [c["name"] for c in cities])
city_id = cities[0]["id"]

payload = {
    "title": "Проверка деплоя Этапа 0",
    "description": "Тестовое общественное событие, создано при проверке деплоя",
    "city_id": city_id,
    "starts_at": "2026-08-10T18:00:00Z",
    "ends_at": "2026-08-10T21:00:00Z",
    "place": "Парк Ак-Гёль",
}
created = session.post(
    f"{BASE}/events/special",
    headers={**HEADERS, "X-Afisha-Admin-CSRF": session_csrf, "Content-Type": "application/json"},
    json=payload,
)
print("create:", created.status_code, created.json())
created.raise_for_status()

time.sleep(1)
listed = session.get(f"{BASE}/events/special", headers=HEADERS)
print("list status:", listed.status_code)
items = listed.json()["items"]
print("special events:", [item["title"] for item in items])

feed = requests.get(f"{PUBLIC}/events", params={"city_id": city_id, "view": "list"}).json()
print("feed titles:", [item["title"] for item in feed.get("items", [])])

sys.exit(0 if any(item["title"] == payload["title"] for item in items) else 1)
